# iScan - Git Ignore File

# Uploaded PDF files
uploads/*.pdf
uploads/*

# Keep uploads directory but ignore contents
!uploads/.gitkeep

# Configuration files with sensitive data
includes/config.php

# Backup files
*.sql.backup
*.bak
backup_*.sql

# Log files
*.log
logs/

# Temporary files
*.tmp
*.temp
temp/
tmp/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.project
.settings/

# PHP specific
vendor/
composer.lock
.env
.env.*
!.env.example

# Local agent/tooling configuration must never be deployed with the web root.
# Existing tracked files still need to be removed from the deployment artifact.
.claude/
.codex/
.agents/

# Session files
sessions/
*.sess

# Cache files
cache/
*.cache

# Node modules (if using any build tools)
node_modules/
npm-debug.log
yarn-error.log

# Build files
dist/
build/

# Local PowerPoint work and render artifacts (keep presentations out of source control)
documents/*.pptx
documents/~$*.pptx
.codex-final-output/
.codex-ppt-render*/
.codex-ppt-security-v17-build/

# Vendor assets (downloaded by download_assets.sh — do not commit binaries)
assets/vendor/

# Test files
tests/
phpunit.xml
.phpunit.result.cache

# Runtime restore previews and job artifacts
storage/

