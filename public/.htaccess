Options -Indexes

# This file is also used when Apache is correctly configured with /public as
# the document root. Keep a defense-in-depth layer for static/error responses.
<FilesMatch "(^\.|\.(env|log|sql|sh|bat|md|gitignore|bak|backup|ini|dist|old|orig|swp|swo|dump|sqlite|db)$)">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header unset X-Powered-By
</IfModule>
